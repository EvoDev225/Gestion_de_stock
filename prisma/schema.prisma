// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleUtilisateur {
  ADMIN
  EMPLOYEE
}

enum TypeMouvement {
  ENTREE
  SORTIE
  AJUSTEMENT
  PERTE
  DOMMAGE
}

enum StatutInventaire {
  EN_COURS
  VALIDE
}

enum TypeRetour {
  CLIENT
  FOURNISSEUR
}

enum StatutVente {
  VALIDEE
  ANNULEE
}
enum ModePaiement {
  TOTAL
  CREDIT
}

enum StatutCommande {
  EN_ATTENTE
  ENVOYEE
  RECUE_PARTIELLE
  RECUE
}

model Utilisateur {
  id                    String                 @id @default(uuid())
  nom                   String
  email                 String                 @unique
  motDePasse            String
  role                  RoleUtilisateur        @default(EMPLOYEE)
  actif                 Boolean                @default(true)
  dateCreation          DateTime               @default(now())
  mouvementsStock       MouvementStock[]
  retours               Retour[]
  ventes                Vente[]
  journalActivites      JournalActivite[]
  inventairesLances  Inventaire[] @relation("InventaireLanceur")
  inventairesValides Inventaire[] @relation("InventaireValidateur")
  commandesFournisseur  CommandeFournisseur[]
  receptionsFournisseur ReceptionFournisseur[]
  rapportsActivite      RapportActivite[]
}

// ... (les autres modèles restent inchangés) ...

model RapportActivite {
  id             String      @id @default(uuid())
  dateDebut      DateTime
  dateFin        DateTime
  contenu        String      @db.Text
  dateGeneration DateTime    @default(now())
  utilisateurId  String
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
}

model Categorie {
  id          String    @id @default(uuid())
  nom         String
  description String?
  produits    Produit[]
}

model Produit {
  id                        String                     @id @default(uuid())
  nom                       String
  sku                       String                     @unique
  description               String?
  imageUrl                  String?
  prixAchat                 Decimal                    @db.Decimal(10, 2)
  prixVente                 Decimal                    @db.Decimal(10, 2)
  seuilMinimum              Int                        @default(0)
  quantiteStock             Int                        @default(0)
  archive                   Boolean                    @default(false)
  dateCreation              DateTime                   @default(now())
  variantes                 Variante[]
  lots                      Lot[]
  lignesInventaire          LigneInventaire[]
  mouvementStocks           MouvementStock[]
  ligneCommandeFournisseurs LigneCommandeFournisseur[]
  lignesRetour              LigneRetour[]
  ligneVentes               LigneVente[]
  categorieId               String?
  categorie                 Categorie?                 @relation(fields: [categorieId], references: [id], onDelete: SetNull)
} 

model Variante {
  id               String            @id @default(uuid())
  nomVariante      String
  skuVariante      String            @unique
  produitId        String
  produit          Produit           @relation(fields: [produitId], references: [id], onDelete: Cascade)
  lots             Lot[]
  lignesInventaire LigneInventaire[]
  mouvementStocks  MouvementStock[]
  lignesRetour     LigneRetour[]
}

model Lot {
  id              String           @id @default(uuid())
  numeroLot       String
  dateExpiration  DateTime
  quantite        Int
  dateReception   DateTime
  produitId       String?
  varianteId      String?
  mouvementStocks MouvementStock[]

  produit  Produit?  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  variante Variante? @relation(fields: [varianteId], references: [id], onDelete: Cascade)
}

model Fournisseur {
  id                   String                @id @default(uuid())
  nom                  String
  email                String?               @unique
  telephone            String
  adresse              String
  commandeFournisseurs CommandeFournisseur[]
}

model Client {
  id        String  @id @default(uuid())
  nom       String
  email     String? @unique
  telephone String?
  adresse   String?
  ventes    Vente[]
}

model MouvementStock {
  id              String           @id @default(uuid())
  typeMouvement   TypeMouvement    @default(ENTREE)
  quantite        Int
  motif           String?
  dateMouvement   DateTime
  utilisateurId   String
  produitId       String
  varianteId      String?
  lotId           String?
  ligneInventaire LigneInventaire?
  utilisateur     Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  produit         Produit          @relation(fields: [produitId], references: [id], onDelete: Restrict)
  variante        Variante?        @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  lot             Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)
}

model Vente {
  id            String       @id @default(uuid())
  dateVente     DateTime
  montantTotal  Decimal      @db.Decimal(10, 2)
  statut        StatutVente  @default(VALIDEE)
  modePaiement  ModePaiement @default(TOTAL)
  clientId      String?
  utilisateurId String
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  utilisateur   Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  ligneVentes   LigneVente[]
  retours       Retour[]
}

model LigneVente {
  id           String  @id @default(uuid())
  quantite     Int
  prixUnitaire Decimal @db.Decimal(10, 2)
  venteId      String
  produitId    String
  vente        Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)
  produit      Produit @relation(fields: [produitId], references: [id], onDelete: Restrict)
}

model CommandeFournisseur {
  id                       String                     @id @default(uuid())
  dateCommande             DateTime
  statut                   StatutCommande             @default(EN_ATTENTE)
  fournisseurId            String
  utilisateurId            String
  ligneCommandeFournisseur LigneCommandeFournisseur[]
  receptionsFournisseur    ReceptionFournisseur[]
  retours                  Retour[]

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)
}

model LigneCommandeFournisseur {
  id                    String              @id @default(uuid())
  quantiteCommande      Int
  prixAchatUnitaire     Decimal             @db.Decimal(10, 2)
  commandeFournisseurId String
  produitId             String
  lignesReception       LigneReception[]
  commandeFournisseur   CommandeFournisseur @relation(fields: [commandeFournisseurId], references: [id], onDelete: Cascade)
  produit               Produit             @relation(fields: [produitId], references: [id], onDelete: Restrict)
}

model ReceptionFournisseur {
  id                    String              @id @default(uuid())
  dateReception         DateTime            @default(now())
  commandeFournisseurId String
  utilisateurId         String
  commandeFournisseur   CommandeFournisseur @relation(fields: [commandeFournisseurId], references: [id], onDelete: Restrict)
  utilisateur           Utilisateur         @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  lignesReception       LigneReception[]
}

model LigneReception {
  id                         String                   @id @default(uuid())
  quantiteRecue              Int
  receptionFournisseurId     String
  ligneCommandeFournisseurId String
  receptionFournisseur       ReceptionFournisseur     @relation(fields: [receptionFournisseurId], references: [id], onDelete: Cascade)
  ligneCommandeFournisseur   LigneCommandeFournisseur @relation(fields: [ligneCommandeFournisseurId], references: [id], onDelete: Restrict)
}

model Retour {
  id                    String               @id @default(uuid())
  typeRetour            TypeRetour
  dateRetour            DateTime             @default(now())
  motif                 String?
  venteId               String?
  commandeFournisseurId String?
  utilisateurId         String
  vente                 Vente?               @relation(fields: [venteId], references: [id], onDelete: Restrict)
  commandeFournisseur   CommandeFournisseur? @relation(fields: [commandeFournisseurId], references: [id], onDelete: Restrict)
  utilisateur           Utilisateur          @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  lignesRetour          LigneRetour[]
}

model LigneRetour {
  id         String    @id @default(uuid())
  quantite   Int
  retourId   String
  produitId  String
  varianteId String?
  retour     Retour    @relation(fields: [retourId], references: [id], onDelete: Cascade)
  produit    Produit   @relation(fields: [produitId], references: [id], onDelete: Restrict)
  variante   Variante? @relation(fields: [varianteId], references: [id], onDelete: Restrict)
}

model Inventaire {
  id                      String            @id @default(uuid())
  dateLancement           DateTime          @default(now())
  statut                  StatutInventaire  @default(EN_COURS)
  
  utilisateurId           String
  utilisateur             Utilisateur       @relation("InventaireLanceur", fields: [utilisateurId], references: [id], onDelete: Restrict)
  
  utilisateurValidateurId String?
  utilisateurValidateur   Utilisateur?      @relation("InventaireValidateur", fields: [utilisateurValidateurId], references: [id], onDelete: Restrict)
  dateValidation          DateTime?

  lignesInventaire        LigneInventaire[]
}

model LigneInventaire {
  id                String          @id @default(uuid())
  quantiteTheorique Int
  quantitePhysique  Int
  ecart             Int
  justification     String?
  inventaireId      String
  produitId         String
  varianteId        String?
  mouvementStockId  String?         @unique
  inventaire        Inventaire      @relation(fields: [inventaireId], references: [id], onDelete: Cascade)
  produit           Produit         @relation(fields: [produitId], references: [id], onDelete: Restrict)
  variante          Variante?       @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  mouvementStock    MouvementStock? @relation(fields: [mouvementStockId], references: [id], onDelete: Restrict)
}

model JournalActivite {
  id                  String      @id @default(uuid())
  action              String
  entiteConcerneeType String?
  entiteConcerneeId   String?
  details             String?
  dateAction          DateTime    @default(now())
  utilisateurId       String
  utilisateur         Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
}
